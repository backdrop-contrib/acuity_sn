    'access arguments' => ['administer site configuration'],
    'type' => MENU_CALLBACK,
  ];

  return $items;
}

/**
 * Implements hook_form_alter().
 *
 * Configures the Title field to show a preview of the serial number
 * if the content type is assigned to a serial group.
 */
function acuity_sn_form_alter(&$form, &$form_state, $form_id) {
  // Check if this is a node form.
  if (isset($form['#node']) && isset($form['title']) && $form['#node']->type) {
    $node = $form['#node'];
    $is_new = empty($node->nid);

    // Load title assignments from config.
    $assignments = config_get('acuity_sn.title_assignment', 'assignments');

    // If the current node type is in the assignment list.
    if (!empty($assignments[$node->type])) {
      $group_id = $assignments[$node->type];

      // Remove the required marker since we are automating it.
      $form['title']['#required'] = FALSE;

      // APPLY READONLY TO BOTH NEW AND EXISTING NODES
      $form['title']['#attributes']['readonly'] = 'readonly';
      // Add visual style for "read-only/auto" feel.
      $form['title']['#attributes']['style'] = 'color: red; font-style: italic;';

      if ($is_new) {
        // Calculate the preview value.
        $preview = '';
        $config = config('acuity_sn.serials');
        $all = $config->get();

        if (isset($all[$group_id])) {
          $next = acuity_sn_peek_next_number($group_id);
          $preview = acuity_sn_format_number($all[$group_id], $next);
        }

        // Set the preview as default value.
        $form['title']['#default_value'] = $preview;

        $form['title']['#description'] = '<span class="abms-sn-provisional-msg">' .
          t('This is a provisional number and may change if other content is saved first.') .
          '</span>';
      }
      else {
        // On edit, we keep the existing title.
        $form['title']['#description'] = t('Assigned Serial Group: @group (Locked)', ['@group' => $group_id]);
      }
    }
  }
}

/**
 * Implements hook_entity_presave().
 */
function acuity_sn_entity_presave($entity, $entity_type) {
  // Skip if entity type doesn't support bundles.
  if (!isset($entity->type)) {
    return;
  }

  // 1. Title injection for nodes.
  if ($entity_type === 'node') {
    $title_map = config_get('acuity_sn.title_assignment', 'assignments');

    // Check if this node type is assigned a serial group.
    if (!empty($title_map[$entity->type])) {

      $is_new = isset($entity->is_new) ? $entity->is_new : (empty($entity->nid));

      // If it is new, we ALWAYS overwrite the title with a fresh serial number.
      // This ensures that the "Preview" value seen in the form is replaced
      // by a strictly locked, atomic serial number.
      if ($is_new) {
        $group_name = $title_map[$entity->type];
        $new_sn = acuity_sn_generate_number($group_name);
        if ($new_sn) {
          $entity->title = $new_sn;
        }
      }
      // Fallback: If for some reason it's not new but the title is empty.
      // Note: titles should never be empty on existing nodes, but just in case.
      elseif (empty($entity->title)) {
        $group_name = $title_map[$entity->type];
        $new_sn = acuity_sn_generate_number($group_name);
        if ($new_sn) {
          $entity->title = $new_sn;
        }
      }
    }
  }

  // 2. Field injection for acuity_sn_widget.
  $instances = field_info_instances($entity_type, $entity->type);
  foreach ($instances as $field_name => $instance) {
    $field = field_info_field($field_name);

    if ($field['type'] === 'text' && isset($instance['widget']['type']) && $instance['widget']['type'] === 'acuity_sn_widget') {
      $lang = LANGUAGE_NONE;
      $group_name = $instance['widget']['settings']['group'] ?? '';

      // Check if it's a new entity.
      $is_new = isset($entity->is_new) ? $entity->is_new : (empty($entity->nid) && empty($entity->id));

      if ($is_new && !empty($group_name)) {
        $value = acuity_sn_generate_number($group_name);
        if ($value) {
          $entity->{$field_name}[$lang][0]['value'] = $value;
        }
      }
      // Restore from hidden field if editing and preserve data exists
      elseif (isset($_POST[$field_name]['preserve'])) {
        if (empty($entity->{$field_name}[$lang][0]['value'])) {
           $entity->{$field_name}[$lang][0]['value'] = $_POST[$field_name]['preserve'];
        }
      }
    }
  }
}

/**
 * Generate the next sequence number for a group.
 * * @param string $group
 * The machine name of the serial group.
 * @return string|null
 * The formatted serial number or NULL on failure.
 */
function acuity_sn_generate_number($group) {
  $lock_name = 'acuity_sn_' . $group;

  if (!lock_acquire($lock_name, 5.0)) {
    watchdog('acuity_sn', 'Could not acquire lock for group: %group', ['%group' => $group], WATCHDOG_ERROR);
    return NULL;
  }

  $config = config('acuity_sn.serials');
  $all = $config->get();

  if (!isset($all[$group])) {
    watchdog('acuity_sn', 'No serial group found for: %group', ['%group' => $group], WATCHDOG_ERROR);
    lock_release($lock_name);
    return NULL;
  }

  $group_data = $all[$group];
  // Ensure min exists if not set
  $min = $group_data['min'] ?? 1;
  $next = max($group_data['next'], $min);

  $formatted = $group_data['prefix']
             . str_pad($next, $group_data['padding'], '0', STR_PAD_LEFT)
             . $group_data['suffix'];

  $group_data['next'] = $next + 1;
  $all[$group] = $group_data;

  // Save config
  $config->setData($all)->save();

  lock_release($lock_name);
  return $formatted;
}

/**
 * Helper: Peek at the next number (for previews).
 */
function acuity_sn_peek_next_number($group) {
  $config = config('acuity_sn.serials');
  $all = $config->get();
  if (!isset($all[$group])) {
    return NULL;
  }

  $group_data = $all[$group];
  $min = $group_data['min'] ?? 1;
  return max($group_data['next'], $min);
}

/**
 * Helper: Format a number based on group settings.
 */
function acuity_sn_format_number($group_data, $number) {
  return $group_data['prefix']
       . str_pad($number, $group_data['padding'], '0', STR_PAD_LEFT)
       . $group_data['suffix'];
}

/**
 * Implements hook_modules_enabled().
 * * Auto-discover serial groups from other modules when they are enabled.
 */
function acuity_sn_modules_enabled($modules) {
  acuity_sn_register_discovered_groups();
}

/**
 * Implements hook_modules_installed().
 * * For Backdrop compatibility ensures discovery runs on install too.
 */
function acuity_sn_modules_installed($modules) {
  acuity_sn_register_discovered_groups();
}

/**
 * Implements hook_config_info().
 * * Declares configuration files so they can be exported/imported.
 */
function acuity_sn_config_info() {
  $prefixes['acuity_sn.serials'] = [
    'label' => t('Acuity Serial Number Settings'),
    'group' => t('Configuration'),
  ];
  $prefixes['acuity_sn.title_assignment'] = [
    'label' => t('Acuity Serial Number Title Assignments'),
    'group' => t('Configuration'),
  ];
  return $prefixes;
}